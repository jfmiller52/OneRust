{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneRust",
  "version": "1.3.0",
  "identifier": "com.onerust.firmware",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneRust — ThinkSystem Firmware",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBREQ2N0ZBQjVBRERDRkUKUldUKzNLMjErbWZkNmxMY1NSb3VnQWpHN2xkdDdsdmFJWkVpV2xpZHFDSnJ1NS9jUFRSWld3TDUK",
      "endpoints": [
        "https://github.com/jfmiller52/OneRust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
